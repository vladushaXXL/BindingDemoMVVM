<UserControl x:Class="BindingDemoMVVM.Controls.TwoWayBindingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:BindingDemoMVVM.Localization;assembly=BindingDemoMVVM.Localization"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="500">
    <StackPanel Margin="20" VerticalAlignment="Top">
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[TwoWay_Title]}"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,10"/>
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[TwoWay_NameLabel]}" Margin="0,0,0,4"/>
        <TextBox Text="{Binding UserName, Mode=TwoWay}" Margin="0,0,0,8"/>

        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[TwoWay_MirrorLabel]}" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding UserName, Mode=OneWay}" FontStyle="Italic" Margin="0,0,0,15"/>

        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[TwoWay_AgeLabel]}" Margin="0,0,0,4"/>
        <Slider Value="{Binding Age}" Minimum="0" Maximum="120" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[TwoWay_AgeValuePrefix]}" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Age}"/>
            <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[TwoWay_AgeValueSuffix]}" Margin="6,0,0,0"/>
        </StackPanel>

        <CheckBox Content="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[TwoWay_IsActiveLabel]}"
                  IsChecked="{Binding IsActive}"
                  Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[TwoWay_IsActiveValuePrefix]}"
                       FontStyle="Italic"
                       Margin="0,0,6,0"/>
            <TextBlock Text="{Binding IsActive}" FontStyle="Italic"/>
        </StackPanel>
    </StackPanel>
</UserControl>

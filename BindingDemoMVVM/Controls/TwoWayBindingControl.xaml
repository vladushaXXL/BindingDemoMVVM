<UserControl x:Class="BindingDemoMVVM.Controls.TwoWayBindingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BindingDemoMVVM.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="500">
    <StackPanel Margin="20" VerticalAlignment="Top">
        <TextBlock Text="Двухсторонняя привязка" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
        <TextBlock Text="Имя (TextBox, TwoWay):" Margin="0,0,0,4"/>
        <TextBox Text="{Binding UserName, Mode=TwoWay}" Margin="0,0,0,8"/>
        <TextBlock Text="Тот же UserName (TextBlock, OneWay — только чтение):" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding UserName, Mode=OneWay}" FontStyle="Italic" Margin="0,0,0,15"/>
        <TextBlock Text="Возраст (Slider):" Margin="0,0,0,4"/>
        <Slider Value="{Binding Age}" Minimum="0" Maximum="100" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding Age, StringFormat='Возраст: {0} лет'}" Margin="0,0,0,15"/>
        <CheckBox Content="Активен (IsActive)" IsChecked="{Binding IsActive}" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding IsActive, StringFormat='IsActive = {0}'}" FontStyle="Italic"/>
    </StackPanel>
</UserControl>

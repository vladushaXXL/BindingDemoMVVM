<UserControl x:Class="BindingDemoMVVM.Controls.TwoWayBindingControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="20">

        <TextBlock FontSize="16" Text="TwoWay Binding"/>

        <Slider Minimum="0"
                Maximum="100"
                Width="200"
                Value="{Binding SliderValue, Mode=TwoWay}"/>

        <TextBox Width="200"
                 Text="{Binding SliderValue, Mode=TwoWay}"/>

        <TextBlock Text="{Binding SliderValue}"
                   FontSize="16"/>

    </StackPanel>

</UserControl>
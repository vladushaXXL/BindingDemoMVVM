<UserControl x:Class="BindingDemoMVVM.Controls.TriggersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:BindingDemoMVVM.Localization;assembly=BindingDemoMVVM.Localization"
             mc:Ignorable="d"
             d:DesignHeight="350"
             d:DesignWidth="500">
    <UserControl.Resources>
        <Style x:Key="HoverButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="LightGreen"/>
            <Setter Property="Padding" Value="15,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Orange"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnimatedButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Button.Click">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="1"
                                             To="1.2"
                                             Duration="0:0:0.1"
                                             AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="1"
                                             To="1.2"
                                             Duration="0:0:0.1"
                                             AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="20" VerticalAlignment="Top">
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[Triggers_Title]}"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,15"/>

        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[Triggers_PropertyTriggerDescription]}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <Button Style="{StaticResource HoverButtonStyle}"
                Content="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[Triggers_HoverButton]}"
                Width="180"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"/>

        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[Triggers_DataTriggerDescription]}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="ConditionCheckBox"
                      Content="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[Triggers_EnableCondition]}"
                      Margin="0,0,15,0"
                      VerticalAlignment="Center"/>
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[Triggers_ConditionOff]}"
                           FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=ConditionCheckBox}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[Triggers_ConditionOn]}"
                           FontSize="14"
                           Foreground="Green"
                           FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=ConditionCheckBox}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </StackPanel>

        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[Triggers_Note]}"
                   Foreground="Gray"
                   FontSize="11"
                   Margin="0,0,0,20"/>

        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[Triggers_EventTriggerDescription]}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <Button Style="{StaticResource AnimatedButtonStyle}"
                Content="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[Triggers_AnimatedButton]}"
                HorizontalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Button.RenderTransform>
        </Button>
    </StackPanel>
</UserControl>

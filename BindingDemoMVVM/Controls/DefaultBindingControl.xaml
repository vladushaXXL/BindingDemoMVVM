<UserControl x:Class="BindingDemoMVVM.Controls.DefaultBindingControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="20">

        <TextBlock FontSize="16" Text="Прямая привязка элементов"/>

        <TextBox x:Name="textBox1" Width="200"/>

        <TextBlock Text="{Binding ElementName=textBox1, Path=Text}" 
                   FontSize="16"/>

        <Separator Margin="10"/>

        <TextBlock FontSize="16" Text="Привязка через ViewModel"/>

        <TextBox Width="200"
                 Text="{Binding TextValue}"/>

        <TextBlock Text="{Binding TextValue}" FontSize="16"/>

    </StackPanel>

</UserControl>
<UserControl x:Class="BindingDemoMVVM.Controls.OneTimeBindingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:BindingDemoMVVM.Localization;assembly=BindingDemoMVVM.Localization"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="500">
    <StackPanel Margin="20" VerticalAlignment="Top">
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[OneTime_Title]}"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,10"/>
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[OneTime_Description]}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[OneTime_InputLabel]}" Margin="0,0,0,4"/>
        <TextBox Text="{Binding InitialValue, Mode=OneTime}" Margin="0,0,0,15"/>
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[OneTime_Note]}"
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   FontSize="11"/>
    </StackPanel>
</UserControl>

<UserControl x:Class="BindingDemoMVVM.Controls.OneWayBindingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BindingDemoMVVM.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="500">
    <StackPanel Margin="20" VerticalAlignment="Top">
        <TextBlock Text="Односторонняя привязка (OneWay)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
        <TextBlock Text="CurrentTime обновляется по таймеру раз в секунду. UI получает обновления только от источника (ViewModel → View)." 
                   TextWrapping="Wrap" Margin="0,0,0,15"/>
        <TextBlock Text="Текущее время:" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding CurrentTime, Mode=OneWay}" FontSize="24" FontWeight="Bold"/>
    </StackPanel>
</UserControl>

<UserControl x:Class="BindingDemoMVVM.Controls.OneWayBindingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:BindingDemoMVVM.Localization;assembly=BindingDemoMVVM.Localization"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="500">
    <StackPanel Margin="20" VerticalAlignment="Top">
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[OneWay_Title]}"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,10"/>
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[OneWay_Description]}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"/>
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationProvider.Instance}, Path=[OneWay_CurrentTimeLabel]}" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding CurrentTime, Mode=OneWay}" FontSize="24" FontWeight="Bold"/>
    </StackPanel>
</UserControl>

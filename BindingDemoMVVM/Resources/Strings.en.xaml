<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <sys:String x:Key="WindowTitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">WPF Binding Demo</sys:String>
    <sys:String x:Key="LanguageLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">Language:</sys:String>
    <sys:String x:Key="ShowMessageButton" xmlns:sys="clr-namespace:System;assembly=mscorlib">Show message</sys:String>
    <sys:String x:Key="TabDefaultBinding" xmlns:sys="clr-namespace:System;assembly=mscorlib">Default binding</sys:String>
    <sys:String x:Key="TabTwoWayBinding" xmlns:sys="clr-namespace:System;assembly=mscorlib">Two-way binding</sys:String>
    <sys:String x:Key="TabOneTimeBinding" xmlns:sys="clr-namespace:System;assembly=mscorlib">One-time binding</sys:String>
    <sys:String x:Key="TabOneWayBinding" xmlns:sys="clr-namespace:System;assembly=mscorlib">One-way binding</sys:String>
    <sys:String x:Key="TabTriggers" xmlns:sys="clr-namespace:System;assembly=mscorlib">Triggers</sys:String>
    <sys:String x:Key="Default_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">Default binding (Mode is not specified)</sys:String>
    <sys:String x:Key="Default_Description" xmlns:sys="clr-namespace:System;assembly=mscorlib">For TextBox the default mode is TwoWay, while TextBlock, Slider and CheckBox use OneWay.</sys:String>
    <sys:String x:Key="Default_TextLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">Text:</sys:String>
    <sys:String x:Key="Default_NumberLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">Number:</sys:String>
    <sys:String x:Key="Default_FlagLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">Flag:</sys:String>
    <sys:String x:Key="Default_FlagContent" xmlns:sys="clr-namespace:System;assembly=mscorlib">Enabled</sys:String>
    <sys:String x:Key="Default_SliderLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">Slider:</sys:String>
    <sys:String x:Key="TwoWay_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">Two-way binding (TwoWay)</sys:String>
    <sys:String x:Key="TwoWay_NameLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">Name (TextBox, TwoWay):</sys:String>
    <sys:String x:Key="TwoWay_MirrorLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">The same UserName value (TextBlock, OneWay - read only):</sys:String>
    <sys:String x:Key="TwoWay_AgeLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">Age (Slider):</sys:String>
    <sys:String x:Key="TwoWay_AgeValuePrefix" xmlns:sys="clr-namespace:System;assembly=mscorlib">Age:</sys:String>
    <sys:String x:Key="TwoWay_AgeValueSuffix" xmlns:sys="clr-namespace:System;assembly=mscorlib">years</sys:String>
    <sys:String x:Key="TwoWay_IsActiveLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">Active (IsActive)</sys:String>
    <sys:String x:Key="TwoWay_IsActiveValuePrefix" xmlns:sys="clr-namespace:System;assembly=mscorlib">IsActive =</sys:String>
    <sys:String x:Key="OneTime_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">One-time binding (OneTime)</sys:String>
    <sys:String x:Key="OneTime_Description" xmlns:sys="clr-namespace:System;assembly=mscorlib">The value is passed only when the view is loaded. Changes in the ViewModel are not reflected afterwards.</sys:String>
    <sys:String x:Key="OneTime_InputLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">TextBox is bound to InitialValue with Mode=OneTime:</sys:String>
    <sys:String x:Key="OneTime_Note" xmlns:sys="clr-namespace:System;assembly=mscorlib">Typing in the TextBox does not refresh the UI from the ViewModel. Changing InitialValue after loading also will not appear on the screen.</sys:String>
    <sys:String x:Key="OneWay_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">One-way binding (OneWay)</sys:String>
    <sys:String x:Key="OneWay_Description" xmlns:sys="clr-namespace:System;assembly=mscorlib">CurrentTime is updated by a timer every second. The UI receives updates only from the source.</sys:String>
    <sys:String x:Key="OneWay_CurrentTimeLabel" xmlns:sys="clr-namespace:System;assembly=mscorlib">Current time:</sys:String>
    <sys:String x:Key="Triggers_Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">Triggers</sys:String>
    <sys:String x:Key="Triggers_PropertyTriggerDescription" xmlns:sys="clr-namespace:System;assembly=mscorlib">1. PropertyTrigger - the button changes color on mouse hover (IsMouseOver):</sys:String>
    <sys:String x:Key="Triggers_HoverButton" xmlns:sys="clr-namespace:System;assembly=mscorlib">Hover over me</sys:String>
    <sys:String x:Key="Triggers_DataTriggerDescription" xmlns:sys="clr-namespace:System;assembly=mscorlib">2. DataTrigger - the text changes when a condition is met (CheckBox IsChecked):</sys:String>
    <sys:String x:Key="Triggers_EnableCondition" xmlns:sys="clr-namespace:System;assembly=mscorlib">Enable condition</sys:String>
    <sys:String x:Key="Triggers_ConditionOff" xmlns:sys="clr-namespace:System;assembly=mscorlib">Condition is off</sys:String>
    <sys:String x:Key="Triggers_ConditionOn" xmlns:sys="clr-namespace:System;assembly=mscorlib">Condition is on!</sys:String>
    <sys:String x:Key="Triggers_Note" xmlns:sys="clr-namespace:System;assembly=mscorlib">(The text and style depend on the CheckBox state)</sys:String>
    <sys:String x:Key="Triggers_EventTriggerDescription" xmlns:sys="clr-namespace:System;assembly=mscorlib">3. EventTrigger - animation when the button is clicked:</sys:String>
    <sys:String x:Key="Triggers_AnimatedButton" xmlns:sys="clr-namespace:System;assembly=mscorlib">Click for animation</sys:String>
    <sys:String x:Key="GreetingTitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">Message</sys:String>
    <sys:String x:Key="GreetingMessageFormat" xmlns:sys="clr-namespace:System;assembly=mscorlib">Hello, {0}! The application language has been switched successfully.</sys:String>
    <sys:String x:Key="FallbackUserName" xmlns:sys="clr-namespace:System;assembly=mscorlib">user</sys:String>
</ResourceDictionary>

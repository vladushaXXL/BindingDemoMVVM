<Window x:Class="BindingDemoMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BindingDemoMVVM.Controls"
        Title="Binding Demo" Height="450" Width="800">

    <Grid>

        <TabControl>

            <TabItem Header="Привязка по умолчанию">
                <controls:DefaultBindingControl/>
            </TabItem>

            <TabItem Header="Двухсторонняя привязка">
                <controls:TwoWayBindingControl/>
            </TabItem>

            <TabItem Header="Одноразовая привязка">
                <controls:OneTimeBindingControl/>
            </TabItem>

            <TabItem Header="Односторонняя привязка">
                <controls:OneWayBindingControl/>
            </TabItem>

            <TabItem Header="Триггеры">
                <controls:TriggersControl/>
            </TabItem>

        </TabControl>

    </Grid>
</Window>
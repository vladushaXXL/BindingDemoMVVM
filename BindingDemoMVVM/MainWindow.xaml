<Window x:Class="BindingDemoMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BindingDemoMVVM.Controls"
        mc:Ignorable="d"
        Title="{Binding LocalizationManager[WindowTitle], Mode=OneWay}"
        Height="560"
        Width="920">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Padding="12"
                Margin="0,0,0,12"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{Binding LocalizationManager[LanguageLabel], Mode=OneWay}"/>
                    <ComboBox Width="150"
                              ItemsSource="{Binding LocalizationManager.SupportedLanguages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="DisplayName"/>
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Width="220"
                        Margin="12,0,0,0"
                        Content="{Binding LocalizationManager[ShowMessageButton], Mode=OneWay}"
                        Command="{Binding ShowGreetingCommand}"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="{Binding LocalizationManager[TabDefaultBinding], Mode=OneWay}">
                <local:DefaultBindingControl DataContext="{Binding DefaultBindingViewModel}"/>
            </TabItem>

            <TabItem Header="{Binding LocalizationManager[TabTwoWayBinding], Mode=OneWay}">
                <local:TwoWayBindingControl DataContext="{Binding TwoWayBindingViewModel}"/>
            </TabItem>

            <TabItem Header="{Binding LocalizationManager[TabOneTimeBinding], Mode=OneWay}">
                <local:OneTimeBindingControl DataContext="{Binding OneTimeBindingViewModel}"/>
            </TabItem>

            <TabItem Header="{Binding LocalizationManager[TabOneWayBinding], Mode=OneWay}">
                <local:OneWayBindingControl DataContext="{Binding OneWayBindingViewModel}"/>
            </TabItem>

            <TabItem Header="{Binding LocalizationManager[TabTriggers], Mode=OneWay}">
                <local:TriggersControl/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
